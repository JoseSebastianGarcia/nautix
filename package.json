{
  "name": "nautix",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @nautix/api --filter @nautix/web dev",
    "build": "pnpm -r build",
    "start": "node apps/api/dist/main.js",
    "demo": "NAUTIX_ENGINE=fake node apps/api/dist/main.js",
    "lint": "biome check . && node scripts/check-layers.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
