# Normalise line endings in the repository to LF so `dotnet format` agrees on Windows runners (core.autocrlf=true there).
* text=auto eol=lf

# Corpus files must keep their exact bytes (CRLF, BOM, missing final newline are test inputs).
corpus/compose/synthetic/* -text
*.sh text eol=lf
*.ps1 text eol=crlf
