<Window x:Class="Nautix.Host.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="urn:nautix:ui"
        Title="{loc:T Shell.Smoke.Title}"
        Width="720" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Nx.Bg0}">
    <Border Margin="24" Padding="24" CornerRadius="12"
            Background="{DynamicResource Nx.Bg1}"
            BorderBrush="{DynamicResource Nx.Line}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{loc:T Shell.Smoke.Heading}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource Nx.Text}" />
            <TextBlock Text="{loc:T Shell.Smoke.Body}" Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource Nx.TextDim}" />

            <TextBlock Text="{loc:T Shell.Smoke.Theme}" Margin="0,24,0,6" FontSize="12"
                       Foreground="{DynamicResource Nx.TextDim}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DarkButton" Content="{loc:T Settings.Theme.Dark}" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="LightButton" Content="{loc:T Settings.Theme.Light}" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="SystemThemeButton" Content="{loc:T Settings.Theme.System}" Padding="14,6" />
            </StackPanel>

            <TextBlock Text="{loc:T Shell.Smoke.Language}" Margin="0,18,0,6" FontSize="12"
                       Foreground="{DynamicResource Nx.TextDim}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="EnglishButton" Content="{loc:T Settings.Language.English}" Padding="14,6" Margin="0,0,8,0" />
                <Button x:Name="SpanishButton" Content="{loc:T Settings.Language.Spanish}" Padding="14,6" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
