{
  "name": "@nautix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NAUTIX_ENGINE=${NAUTIX_ENGINE:-socket} tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nautix/compose": "workspace:*",
    "@nautix/contracts": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "better-sqlite3": "^12.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
