<Window x:Class="Nautix.Spikes.S5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="S5 - Editor spike" Width="1000" Height="700"
        Background="{DynamicResource Nx.Bg0}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button x:Name="DarkButton" Content="Dark" Margin="0,0,8,0" Padding="12,4" />
            <Button x:Name="LightButton" Content="Light" Margin="0,0,8,0" Padding="12,4" />
            <Button x:Name="ValidButton" Content="Sample: valid" Margin="0,0,8,0" Padding="12,4" />
            <Button x:Name="BrokenButton" Content="Sample: broken" Margin="0,0,8,0" Padding="12,4" />
            <Button x:Name="BigButton" Content="Load 5000 lines" Padding="12,4" />
        </StackPanel>
        <avalon:TextEditor x:Name="Editor"
                           FontFamily="Cascadia Code, Consolas"
                           FontSize="13"
                           ShowLineNumbers="True"
                           Background="{DynamicResource Nx.Bg1}"
                           Foreground="{DynamicResource Nx.Text}"
                           LineNumbersForeground="{DynamicResource Nx.TextDim}" />
    </DockPanel>
</Window>
